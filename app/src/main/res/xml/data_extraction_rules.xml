<?xml version="1.0" encoding="utf-8"?>
<!-- Used on Android 12 and newer. The list of sources is restored on a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="sources.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="sources.json" />
    </device-transfer>
</data-extraction-rules>
